DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,testserver

# PostgreSQL (Neon / Supabase / Railway / Render / local)
# Examples:
#   postgres://USER:PASSWORD@HOST:5432/DBNAME
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ehinga?sslmode=require

# Local fallback only:
# DATABASE_URL=sqlite:///db.sqlite3

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ALL_ORIGINS=False

# Google AI — never commit real keys
GOOGLE_AI_API_KEY=
GEMINI_API_KEY=

GOOGLE_OAUTH_CLIENT_ID=

# Phone video uploads (50 MB)
DATA_UPLOAD_MAX_MEMORY_SIZE=52428800
FILE_UPLOAD_MAX_MEMORY_SIZE=52428800

REDIS_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND_URL=redis://localhost:6379/3

R2_ENABLED=False
